rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';}
  function employee(){return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee';}
  match /users/{uid}{allow read: if signedIn() && (request.auth.uid==uid || admin()); allow write: if admin();}
  match /daily_agenda/{id}{allow create: if employee() || admin(); allow read,update,delete: if admin();}
  match /settings/{id}{allow read,write: if admin();}
 }
}
